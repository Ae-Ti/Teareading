{
  "name": "teareading",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:types": "supabase gen types typescript --local > types/database.ts",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:auth": "node --import tsx --test tests/auth.test.ts",
    "test:auth:db": "node --import tsx --test tests/auth.db.test.ts",
    "test:profile": "node --import tsx --test tests/profile.test.ts",
    "test:profile:db": "node --import tsx --test tests/profile.db.test.ts",
    "test:profile:e2e": "playwright test --config tests/auth.playwright.config.ts profile.spec.ts",
    "test:auth:e2e": "playwright test --config tests/auth.playwright.config.ts",
    "test:chat": "node --import tsx --test tests/chat.test.ts",
    "test:chat:db": "node --import tsx --test tests/chat.db.test.ts",
    "test:chat:e2e": "playwright test --config tests/auth.playwright.config.ts group-chat.spec.ts",
    "test:dm:db": "node --import tsx --test tests/dm.db.test.ts",
    "test:dm:e2e": "playwright test --config tests/auth.playwright.config.ts dm.spec.ts",
    "test:legal": "node --import tsx --test tests/legal.test.ts",
    "test:landing:e2e": "playwright test --config tests/auth.playwright.config.ts landing-legal.spec.ts",
    "test:cross:e2e": "playwright test --config tests/auth.playwright.config.ts cross-taeil.spec.ts",
    "test:account:db": "node --import tsx --test tests/account.db.test.ts",
    "test:account:e2e": "playwright test --config tests/auth.playwright.config.ts account.spec.ts",
    "test:moderation:db": "node --import tsx --test tests/moderation.db.test.ts",
    "test:board:db": "node --import tsx --test tests/board.db.test.ts",
    "test:board:e2e": "playwright test --config tests/auth.playwright.config.ts board.spec.ts",
    "test:community:e2e": "playwright test --config tests/auth.playwright.config.ts community.spec.ts",
    "test:rls": "node --import tsx --test tests/rls.db.test.ts",
    "test:space": "node --import tsx --test tests/space.test.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "marked": "^18.1.3",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
